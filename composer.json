{
    "name": "jomweb/billplz",
    "description": "PHP Agnostic library for working with BillPlz API",
    "type": "library",
    "keywords": ["Billplz", "Payment Gateway"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mior Muhammad Zaki",
            "email": "crynobone@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Billplz\\": "src/",
            "Laravie\\Codex\\": "src/Internal/Codex/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Billplz\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/psr7": "^2.8",
        "moneyphp/money": "^4.0",
        "php-http/client-common": "^2.7",
        "php-http/client-implementation": "^1.0",
        "php-http/discovery": "^1.20",
        "php-http/message": "^1.16",
        "php-http/multipart-stream-builder": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-drift": "^4.0",
        "php-http/guzzle7-adapter": "^1.1",
        "phpstan/phpstan": "^2.1",
        "symfony/console": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/options-resolver": "^7.4",
        "symfony/process": "^7.4",
        "symfony/string": "^7.4"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-6.x": "6.x-dev"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist",
        "test": "vendor/bin/pest",
        "test:parallel": "vendor/bin/pest --parallel",
        "qa": [
            "@lint",
            "@analyse",
            "@test:parallel"
        ],
        "hooks:install": "git config core.hooksPath .githooks"
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}
